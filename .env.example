# Copia este archivo como .env y completa los valores.

# --- Neo4j (base viva: portal del estudiante y gestión) ---
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j   # con Aura nueva: pon aquí el ID de la instancia (también sirve NEO4J_USERNAME)
NEO4J_PASSWORD=tu_password
# Opcional: solo si tu base no usa el nombre por defecto

# --- PostgreSQL (espejo relacional: solo para la comparación) ---
PG_DSN=postgresql://postgres:postgres@localhost:5432/uni

# --- Aplicación ---
PERIODO_ACTUAL=2026-2
# Opcional: si lo defines, el administrador debe escribirlo para entrar
ADMIN_PIN=
